<!-- Mock REST API Modal -->
<div id="api-modal" class="modal-root fixed inset-0 z-50 hidden items-center justify-center modal-backdrop p-4">
  <div class="bg-dark-card border border-dark rounded-lg shadow-2xl w-full max-w-3xl flex flex-col overflow-hidden">
    
    <!-- Modal Header -->
    <div class="px-6 py-4 border-b border-dark flex items-center justify-between bg-[#2f2f2f]">
      <div>
        <h3 class="text-base font-bold text-white flex items-center gap-2">
          <span>Local Mock REST API</span>
          <span class="text-xs px-2 py-0.5 rounded bg-emerald-700 text-white font-normal">Active & Ready</span>
        </h3>
        <p class="text-xs text-gray-400">Consume real-time simulated REST data directly in your frontend or test pipelines</p>
      </div>
      <button type="button" onclick="closeModal('api-modal')" class="text-gray-400 hover:text-white p-1 rounded">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Body -->
    <div class="p-6 space-y-5 overflow-y-auto max-h-[75vh] bg-dark-main text-xs">
      
      <!-- Endpoint Details -->
      <div class="p-3.5 bg-dark-input rounded-md border border-dark space-y-2">
        <div class="flex items-center gap-2">
          <span class="px-2 py-0.5 rounded font-bold bg-green-700 text-white font-mono">GET</span>
          <code class="text-sm font-mono text-white">/api/mock/<span class="text-yellow-400">:schemaId</span></code>
        </div>
        <p class="text-gray-400">
          Returns dynamically generated records in JSON format using the saved schema definition.
        </p>
        <div class="flex flex-wrap gap-2 pt-1 text-[11px] text-gray-300">
          <span class="bg-dark-card px-2 py-0.5 rounded border border-dark font-mono">?count=10</span> (Number of records, 1-1000)
          <span class="bg-dark-card px-2 py-0.5 rounded border border-dark font-mono">?delay=300</span> (Simulated network latency in ms)
          <span class="bg-dark-card px-2 py-0.5 rounded border border-dark font-mono">?format=json|csv</span>
        </div>
      </div>

      <!-- Quick Test Links -->
      <div>
        <span class="font-semibold text-gray-300 block mb-2">Try active presets in your browser:</span>
        <div class="flex flex-wrap gap-2">
          <a href="/api/mock/users?count=5" target="_blank" class="api-link px-3 py-1.5 rounded bg-dark-card border border-dark hover:border-green-500 text-green-400 font-mono transition flex items-center gap-1">
            <span>/api/mock/users</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
          </a>
          <a href="/api/mock/ecommerce?count=5" target="_blank" class="api-link px-3 py-1.5 rounded bg-dark-card border border-dark hover:border-green-500 text-green-400 font-mono transition flex items-center gap-1">
            <span>/api/mock/ecommerce</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
          </a>
          <a href="/api/mock/transactions?count=5" target="_blank" class="api-link px-3 py-1.5 rounded bg-dark-card border border-dark hover:border-green-500 text-green-400 font-mono transition flex items-center gap-1">
            <span>/api/mock/transactions</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
          </a>
        </div>
      </div>

      <!-- Code Snippets -->
      <div class="space-y-3">
        <div>
          <span class="font-semibold text-gray-300 block mb-1">cURL Example:</span>
          <pre id="curl-example" class="bg-dark-input p-3 rounded border border-dark font-mono text-gray-300 overflow-x-auto">curl "http://localhost:4000/api/mock/users?count=5"</pre>
        </div>

        <div>
          <span class="font-semibold text-gray-300 block mb-1">JavaScript Fetch Example:</span>
          <pre id="fetch-example" class="bg-dark-input p-3 rounded border border-dark font-mono text-gray-300 overflow-x-auto">const res = await fetch(`${window.location.origin}/api/mock/users?count=10`);
const users = await res.json();
console.log(users);</pre>
        </div>
      </div>

    </div>

    <!-- Footer -->
    <div class="px-6 py-3 border-t border-dark bg-[#2f2f2f] flex justify-end">
      <button 
        type="button" 
        onclick="closeModal('api-modal')" 
        class="px-4 py-1.5 rounded bg-dark-input border border-dark text-gray-300 hover:text-white font-medium"
      >
        Close
      </button>
    </div>

  </div>
</div>
<script>
document.addEventListener('DOMContentLoaded', () => {
  const origin = window.location.origin;
  const curlPre = document.getElementById('curl-example');
  if (curlPre) curlPre.textContent = `curl "${origin}/api/mock/users?count=5"`;
});
</script>
