<!-- Type Picker Modal -->
<div id="type-modal" class="modal-root fixed inset-0 z-50 hidden items-center justify-center modal-backdrop p-4">
  <div class="bg-dark-card border border-dark rounded-lg shadow-2xl w-full max-w-4xl max-h-[90vh] flex flex-col overflow-hidden">
    
    <!-- Modal Header -->
    <div class="px-6 py-4 border-b border-dark flex items-center justify-between bg-[#2f2f2f]">
      <div>
        <h3 class="text-lg font-bold text-white flex items-center gap-2">
          <span>Choose a Data Type</span>
          <span class="text-xs px-2 py-0.5 rounded bg-primary-green text-white font-normal"><%= Object.keys(dataTypes).length %> types</span>
        </h3>
        <p class="text-xs text-gray-400">Select the realistic data generator for this column</p>
      </div>
      <button type="button" onclick="closeModal('type-modal')" class="text-gray-400 hover:text-white p-1 rounded">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Search & Category Filters -->
    <div class="p-4 border-b border-dark bg-[#333333] space-y-3">
      <div class="relative">
        <input 
          type="text" 
          id="type-search" 
          oninput="filterTypes(this.value)" 
          placeholder="Search types (e.g., email, credit card, address, phone)..." 
          class="w-full bg-dark-input border border-dark rounded-md px-4 py-2 pl-10 text-sm text-white focus:outline-none focus:border-green-500"
        >
        <svg class="w-5 h-5 text-gray-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
      </div>

      <!-- Categories Bar -->
      <div class="flex items-center gap-1.5 overflow-x-auto pb-1 text-xs">
        <button 
          type="button" 
          onclick="filterByCategory('ALL')" 
          data-category="ALL"
          class="category-btn px-3 py-1 rounded bg-primary-green text-white font-medium hover:opacity-90 shrink-0 transition"
        >
          All
        </button>
        <% categories.forEach(cat => { %>
          <button 
            type="button" 
            onclick="filterByCategory('<%= cat %>')" 
            data-category="<%= cat %>"
            class="category-btn px-3 py-1 rounded bg-dark-card border border-dark text-gray-300 hover:text-white hover:border-gray-500 font-medium shrink-0 transition"
          >
            <%= cat %>
          </button>
        <% }) %>
      </div>
    </div>

    <!-- Type Cards Container -->
    <div id="type-cards-list" class="flex-1 overflow-y-auto p-5 space-y-6 bg-dark-main">
      <% categories.forEach(cat => { %>
        <div class="category-section" data-category="<%= cat %>">
          <h4 class="text-xs font-bold uppercase tracking-wider text-gray-400 mb-3 border-b border-dark pb-1">
            <%= cat %>
          </h4>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-2.5">
            <% Object.entries(dataTypes).filter(([_, d]) => d.category === cat).forEach(([key, d]) => { %>
              <div 
                class="type-card cursor-pointer p-3 rounded border border-dark bg-dark-card hover:bg-dark-card-hover hover:border-green-500 transition group"
                data-name="<%= d.name %>"
                data-category="<%= d.category %>"
                data-desc="<%= d.description %>"
                onclick="selectType('<%= key %>', '<%= d.name %>')"
              >
                <div class="flex items-center justify-between mb-1">
                  <span class="text-sm font-semibold text-white group-hover:text-green-400 transition"><%= d.name %></span>
                  <span class="text-[10px] px-1.5 py-0.5 rounded bg-dark-input text-gray-400 font-mono"><%= key %></span>
                </div>
                <p class="text-xs text-gray-400 line-clamp-2"><%= d.description %></p>
              </div>
            <% }) %>
          </div>
        </div>
      <% }) %>
    </div>

  </div>
</div>
