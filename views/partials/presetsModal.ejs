<!-- Presets & Saved Schemas Modal -->
<div id="presets-modal" class="modal-root fixed inset-0 z-50 hidden items-center justify-center modal-backdrop p-4">
  <div class="bg-dark-card border border-dark rounded-lg shadow-2xl w-full max-w-2xl flex flex-col overflow-hidden">
    
    <!-- Modal Header -->
    <div class="px-6 py-4 border-b border-dark flex items-center justify-between bg-[#2f2f2f]">
      <div>
        <h3 class="text-base font-bold text-white flex items-center gap-2">
          <span>Schemas & Templates</span>
        </h3>
        <p class="text-xs text-gray-400">Load ready-to-use domain templates or manage your saved schemas</p>
      </div>
      <button type="button" onclick="closeModal('presets-modal')" class="text-gray-400 hover:text-white p-1 rounded">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Body -->
    <div class="p-6 space-y-5 overflow-y-auto max-h-[70vh] bg-dark-main text-xs">
      
      <!-- Save Current Schema Form -->
      <div class="p-4 bg-dark-input rounded-md border border-dark space-y-2">
        <span class="font-semibold text-gray-200 block text-sm">Save Current Schema</span>
        <div class="flex gap-2">
          <input 
            type="text" 
            id="save-schema-name" 
            placeholder="Schema name (e.g. customers_v2)" 
            class="flex-1 bg-dark-card border border-dark rounded px-3 py-1.5 text-white focus:outline-none focus:border-green-500 font-mono"
          >
          <button 
            type="button" 
            onclick="saveCurrentSchema()" 
            class="px-4 py-1.5 rounded bg-primary-green hover:bg-green-600 text-white font-semibold transition"
          >
            Save Schema
          </button>
        </div>
      </div>

      <!-- Presets List -->
      <div>
        <span class="font-semibold text-gray-300 block mb-3 text-sm">Available Templates:</span>
        <div class="space-y-2.5">
          <% Object.values(presets).forEach(p => { %>
            <div class="p-3 bg-dark-card rounded border border-dark flex items-center justify-between hover:border-gray-500 transition">
              <div>
                <span class="font-bold text-white text-sm"><%= p.name %></span>
                <p class="text-gray-400 text-xs mt-0.5"><%= p.description || '' %></p>
                <span class="text-[11px] text-gray-500 font-mono"><%= p.fields ? p.fields.length : 0 %> fields</span>
              </div>
              <a 
                href="/preset/<%= p.id %>" 
                class="px-3.5 py-1.5 rounded bg-dark-input border border-dark hover:border-green-500 text-green-400 font-medium transition"
              >
                Load Schema
              </a>
            </div>
          <% }) %>
        </div>
      </div>

    </div>

    <!-- Footer -->
    <div class="px-6 py-3 border-t border-dark bg-[#2f2f2f] flex justify-end">
      <button 
        type="button" 
        onclick="closeModal('presets-modal')" 
        class="px-4 py-1.5 rounded bg-dark-input border border-dark text-gray-300 hover:text-white font-medium"
      >
        Close
      </button>
    </div>

  </div>
</div>

<script>
function saveCurrentSchema() {
  const nameInput = document.getElementById('save-schema-name');
  const name = nameInput.value.trim();
  if (!name) {
    alert('Please enter a schema name.');
    return;
  }

  const form = document.getElementById('schema-form');
  const formData = new FormData(form);
  formData.append('schema_name', name);

  fetch('/schemas/save', {
    method: 'POST',
    body: new URLSearchParams(formData)
  })
  .then(res => res.json())
  .then(data => {
    if (data.ok) {
      alert(`Schema "${name}" successfully saved! Available in Mock API as: /api/mock/${data.id}`);
      window.location.reload();
    } else {
      alert('Error saving schema: ' + (data.error || 'Unknown error'));
    }
  })
  .catch(err => alert('Network error: ' + err.message));
}
</script>
