<!DOCTYPE html>
<html lang="en" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mockaroo Local - Realistic Test Data Generator & Mock API</title>
  
  <!-- Cleanup any legacy Service Workers from other localhost projects -->
  <script>
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.getRegistrations().then(function(registrations) {
        for (let r of registrations) r.unregister();
      });
    }
    if ('caches' in window) {
      caches.keys().then(function(names) {
        for (let name of names) caches.delete(name);
      });
    }
  </script>

  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            'primary-green': '#52a552',
            'primary-green-hover': '#438843',
            'dark-main': '#2b2b2b',
            'dark-card': '#383838',
            'dark-card-hover': '#424242',
            'dark-input': '#242424',
            'dark-border': '#4a4a4a',
          }
        }
      }
    }
  </script>

  <!-- Local Custom CSS -->
  <link rel="stylesheet" href="/css/style.css">

  <!-- HTMX, SortableJS & WebMCP -->
  <script src="/js/htmx.min.js"></script>
  <script src="/js/sortable.min.js"></script>
  <script src="/js/app.js" defer></script>
  <script src="/js/fastwebmcp.bundle.js"></script>
  <script src="/js/webmcp-tools.js" defer></script>
</head>
<body class="bg-[#2b2b2b] text-gray-200 min-h-screen flex flex-col font-sans">

  <!-- Header Bar -->
  <header class="bg-[#383838] border-b border-[#4a4a4a] px-6 py-3 flex items-center justify-between sticky top-0 z-30 shadow-md">
    <div class="flex items-center gap-4">
      <div class="flex items-center gap-2">
        <!-- Logo SVG -->
        <div class="bg-primary-green text-white p-1.5 rounded-lg flex items-center justify-center font-black tracking-tighter text-xl leading-none">
          M
        </div>
        <div class="flex items-baseline gap-1.5">
          <span class="text-2xl font-black tracking-tight text-white font-mono">mockaroo</span>
          <span class="text-xs px-2 py-0.5 rounded font-bold uppercase tracking-wider bg-emerald-800 text-green-200">local</span>
        </div>
      </div>

      <span class="text-gray-500">|</span>
      <span class="text-xs text-gray-400 hidden sm:inline">Offline Synthetic Data Generator & Mock REST Server</span>
    </div>

    <!-- Top Right Actions -->
    <div class="flex items-center gap-2">
      <button 
        type="button" 
        id="btn-open-presets"
        onclick="openModal('presets-modal')" 
        class="px-3 py-1.5 rounded bg-[#2a2a2a] hover:bg-[#444] border border-[#4a4a4a] text-xs text-gray-200 font-medium transition flex items-center gap-1.5"
      >
        <svg class="w-4 h-4 text-primary-green" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path></svg>
        <span>Templates (<%= activePresetName %>)</span>
      </button>

      <button 
        type="button" 
        id="btn-open-api"
        onclick="openModal('api-modal')" 
        class="px-3 py-1.5 rounded bg-emerald-900/40 hover:bg-emerald-900/60 border border-emerald-700 text-xs text-green-300 font-medium transition flex items-center gap-1.5"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
        <span>Mock REST API</span>
      </button>

      <button 
        type="button" 
        id="btn-open-webmcp"
        onclick="openModal('webmcp-modal')" 
        class="px-3 py-1.5 rounded bg-purple-950/60 hover:bg-purple-900/80 border border-purple-700 text-xs text-purple-300 font-semibold transition flex items-center gap-1.5 shadow"
      >
        <svg class="w-4 h-4 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
        <span>WebMCP (AI Agent)</span>
      </button>
    </div>
  </header>

  <!-- Main Container -->
  <main class="flex-1 max-w-7xl w-full mx-auto p-4 md:p-6 flex flex-col space-y-4">
    
    <!-- Info Banner -->
    <div class="bg-[#383838] border border-[#4a4a4a] rounded-lg p-3 px-4 flex flex-wrap items-center justify-between gap-3 text-xs">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-primary-green animate-pulse"></span>
        <span class="text-gray-300 font-medium">100% Local & Unlimited:</span>
        <span class="text-gray-400">Generate millions of records directly on your machine without cloud latency or quota limits.</span>
      </div>
      <div class="flex items-center gap-2 text-gray-400">
        <span>Current Template:</span>
        <strong class="text-white bg-[#262626] px-2 py-0.5 rounded border border-[#4a4a4a]"><%= activePresetName %></strong>
      </div>
    </div>

    <!-- Form Container -->
    <form id="schema-form" action="/generate" method="POST" class="flex-1 flex flex-col space-y-4">
      
      <!-- Action Toolbar -->
      <div class="flex flex-wrap items-center justify-between gap-3 bg-[#333] p-3 rounded-lg border border-[#4a4a4a]">
        
        <!-- Left: Primary buttons -->
        <div class="flex items-center gap-2">
          <!-- Generate / Download Button -->
          <button 
            type="submit" 
            id="btn-generate-data"
            class="px-5 py-2 rounded font-bold text-sm bg-primary-green hover:bg-[#438843] text-white shadow transition flex items-center gap-2"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
            <span>Generate Data</span>
          </button>

          <!-- Preview Button (HTMX post to /preview) -->
          <button 
            type="button" 
            id="btn-preview"
            hx-post="/preview" 
            hx-target="#preview-container" 
            hx-swap="innerHTML"
            hx-include="#schema-form"
            class="px-4 py-2 rounded font-medium text-sm bg-[#242424] hover:bg-[#3f3f3f] border border-[#4a4a4a] text-gray-200 transition flex items-center gap-1.5"
          >
            <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
            <span>Preview</span>
          </button>
        </div>

        <!-- Right: Field Count & Add Field -->
        <div class="flex items-center gap-2">
          <button 
            type="button" 
            id="btn-add-field-top"
            hx-post="/fields/add" 
            hx-target="#fields-container" 
            hx-swap="beforeend"
            class="px-3.5 py-1.5 rounded font-medium text-xs bg-dark-input hover:bg-[#3f3f3f] border border-dark text-gray-200 transition flex items-center gap-1.5"
          >
            <svg class="w-4 h-4 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
            <span>Add another field</span>
          </button>
        </div>
      </div>

      <!-- Table Header Labels -->
      <div class="flex items-center gap-3 px-3 py-1 text-xs font-bold uppercase tracking-wider text-gray-400 select-none">
        <div class="w-5 text-center"></div>
        <div class="w-56">Field Name</div>
        <div class="w-56">Type</div>
        <div class="flex-1">Options & Formulas</div>
        <div class="w-8"></div>
      </div>

      <!-- Fields List (Draggable with SortableJS) -->
      <div id="fields-container" class="space-y-2">
        <% fields.forEach(field => { %>
          <%- include('partials/fieldRow', { field, dataTypes }) %>
        <% }) %>
      </div>

      <!-- Bottom Add Button -->
      <div>
        <button 
          type="button" 
          id="btn-add-field-bottom"
          hx-post="/fields/add" 
          hx-target="#fields-container" 
          hx-swap="beforeend"
          class="px-4 py-2 rounded font-medium text-xs bg-[#333] hover:bg-[#3f3f3f] border border-dashed border-[#555] hover:border-green-500 text-gray-300 transition flex items-center gap-2"
        >
          <svg class="w-4 h-4 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
          <span>Add another field</span>
        </button>
      </div>

      <!-- Export Configuration Bar -->
      <div class="bg-[#333] p-4 rounded-lg border border-[#4a4a4a] mt-6 flex flex-wrap items-center justify-between gap-4">
        
        <div class="flex flex-wrap items-center gap-5 text-xs text-gray-300">
          
          <!-- Number of Rows -->
          <div class="flex items-center gap-2">
            <label class="font-semibold text-gray-400"># Rows:</label>
            <input 
              type="number" 
              name="num_rows" 
              id="input-num-rows"
              min="1" 
              max="200000" 
              value="1000" 
              class="w-24 bg-dark-input border border-dark rounded px-2.5 py-1.5 text-sm text-white font-mono focus:outline-none focus:border-green-500"
            >
          </div>

          <!-- Format Selector -->
          <div class="flex items-center gap-2">
            <label class="font-semibold text-gray-400">Format:</label>
            <select 
              name="file_format" 
              id="file-format-select"
              onchange="handleFormatChange(this.value)"
              class="bg-dark-input border border-dark rounded px-3 py-1.5 text-sm text-white font-medium focus:outline-none focus:border-green-500"
            >
              <option value="csv" selected>CSV</option>
              <option value="json">JSON</option>
              <option value="sql">SQL (INSERT)</option>
              <option value="excel">Excel (.xlsx)</option>
            </select>
          </div>

          <!-- Dynamic Format Options -->
          <div id="csv-options" class="format-opts flex items-center gap-4">
            <div class="flex items-center gap-1.5">
              <label class="text-gray-400">Delimiter:</label>
              <select name="csv_delimiter" class="bg-dark-input border border-dark rounded px-2 py-1 text-xs text-white">
                <option value=",">Comma (,)</option>
                <option value=";">Semicolon (;)</option>
                <option value="&#9;">Tab (\t)</option>
                <option value="|">Pipe (|)</option>
              </select>
            </div>
            <label class="flex items-center gap-1.5 cursor-pointer">
              <input type="checkbox" name="csv_header" value="true" checked class="rounded bg-dark-input border-dark text-green-500 focus:ring-0">
              <span>Header</span>
            </label>
            <label class="flex items-center gap-1.5 cursor-pointer">
              <input type="checkbox" name="csv_bom" value="true" class="rounded bg-dark-input border-dark text-green-500 focus:ring-0">
              <span>BOM</span>
            </label>
          </div>

          <div id="sql-options" class="format-opts hidden flex items-center gap-4">
            <div class="flex items-center gap-1.5">
              <label class="text-gray-400">Table Name:</label>
              <input type="text" name="sql_table" value="mock_data" class="bg-dark-input border border-dark rounded px-2 py-1 text-xs text-white font-mono w-28">
            </div>
            <div class="flex items-center gap-1.5">
              <label class="text-gray-400">Dialect:</label>
              <select name="sql_dialect" class="bg-dark-input border border-dark rounded px-2 py-1 text-xs text-white">
                <option value="postgres">PostgreSQL</option>
                <option value="mysql">MySQL</option>
                <option value="sqlite">SQLite</option>
              </select>
            </div>
          </div>

          <div id="json-options" class="format-opts hidden flex items-center gap-4">
            <label class="flex items-center gap-1.5 cursor-pointer">
              <input type="checkbox" name="json_minify" value="true" class="rounded bg-dark-input border-dark text-green-500 focus:ring-0">
              <span>Minified (1-line)</span>
            </label>
          </div>

        </div>

        <!-- Download Action -->
        <div>
          <button 
            type="submit" 
            class="px-6 py-2 rounded font-bold text-sm bg-primary-green hover:bg-[#438843] text-white shadow transition flex items-center gap-2"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
            <span>Download</span>
          </button>
        </div>

      </div>

    </form>
  </main>

  <!-- Modals & Containers -->
  <div id="preview-container"></div>
  <%- include('partials/typeModal', { dataTypes, categories }) %>
  <%- include('partials/formulaModal') %>
  <%- include('partials/presetsModal', { presets }) %>
  <%- include('partials/apiModal') %>
  <%- include('partials/webmcpModal') %>

  <!-- Footer -->
  <footer class="bg-[#242424] border-t border-[#3a3a3a] py-3 text-center text-xs text-gray-500">
    <span>Mockaroo Local v1.0.0 &bull; Running on Node.js &amp; HTMX &bull; 100% Offline Capable</span>
  </footer>

  <script>
    function handleFormatChange(fmt) {
      document.querySelectorAll('.format-opts').forEach(el => el.classList.add('hidden'));
      if (fmt === 'csv') document.getElementById('csv-options')?.classList.remove('hidden');
      if (fmt === 'sql') document.getElementById('sql-options')?.classList.remove('hidden');
      if (fmt === 'json') document.getElementById('json-options')?.classList.remove('hidden');
    }
  </script>
</body>
</html>
